{
  "name": "vaultos",
  "version": "0.3.0-preview.4",
  "private": true,
  "description": "A local-first vault for project secrets with an MCP bridge for coding agents. The app is Rust; these scripts build, test and package it.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KRNL-Studio/vaultos.git"
  },
  "bugs": {
    "url": "https://github.com/KRNL-Studio/vaultos/issues"
  },
  "homepage": "https://github.com/KRNL-Studio/vaultos#readme",
  "scripts": {
    "start": "cargo run -p vaultos-desktop",
    "test": "node --test test/*.test.js",
    "test:desktop": "node scripts/test-desktop-ui.mjs && node scripts/test-desktop-service.mjs",
    "check": "node scripts/check.mjs && npm test",
    "dist:mac": "node scripts/package-mac.mjs",
    "dist:linux": "node scripts/package-linux.mjs"
  }
}
