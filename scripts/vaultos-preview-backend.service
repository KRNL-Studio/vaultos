# systemd user unit template for VaultOS background access.
#
# scripts/install-linux.sh --enable-service renders this to
# ~/.config/systemd/user/vaultos-preview-backend.service, replacing @APP@ with the installed
# app's absolute path, and enables it. Nothing installs it otherwise.
#
# The service unlocks only when background access is on in the desktop Settings (password
# remembered in the Secret Service) and a manual lock has not blocked it. Opening the
# desktop asks it to stop and takes over; it takes over again when the desktop lets go.
[Unit]
Description=VaultOS background access
Documentation=https://github.com/KRNL-Studio/vaultos/blob/main/docs/AGENTS.md

[Service]
Type=simple
ExecStart="@APP@" --service
# The service exits 0 when a restart cannot help (no vault yet, background access off, or a
# remembered password that no longer opens the vault), so only unexpected failures retry.
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
