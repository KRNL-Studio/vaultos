{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultOS",
  "version": "0.3.0-preview.4",
  "identifier": "org.vaultos.preview",
  "build": {
    "frontendDist": "../../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'none'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "MIT licence. Unsigned preview.",
    "icon": [
      "../../build/icon_1024.png",
      "../../build/AppIcon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNzc0NkYzMTNCNkI4NkIKUldScnVMWVQ4MFozZ3hTQzVRN3RTZUZ5aUx5SXBkUlcyQ3Y3R2dMYnl3MFZoQ05ZT0wvNGRwR3YK",
      "endpoints": [
        "https://github.com/KRNL-Studio/vaultos/releases/download/updates/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
